# Escolha pelo menos um provedor de LLM e preencha sua chave abaixo.
# Renomeie este arquivo para ".env" antes de executar a aplicação.

# Provedor Padrão (Recomendado - possui nível gratuito no Google AI Studio)
GOOGLE_API_KEY=sua_chave_google_gemini_aqui

# Provedor Alternativo (Opcional)
OPENAI_API_KEY=sua_chave_openai_aqui
